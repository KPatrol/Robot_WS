# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtualenvs
.venv/
venv/
env/

# Build / dist
build/
dist/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Arduino / PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Local-only env / state
.env
.env.local
*.local
.deploy-stash-marker

# MQTT credentials — use mqtt.env.example as template
pi-controller/mqtt.env

# Generated artifacts
*.log
*.pid
runtime/

# ROS / colcon
build/
install/
log/

# Datasets and large media we don't want to commit by default
pi-controller/detection/datasets/*.zip
pi-controller/detection/datasets/raw/

# Screenshots from the simulator (regenerated on every run)
pi-controller/tools/screenshots/

# ML model weights — fetched on-device, not stored in repo
pi-controller/*.pt
pi-controller/*.onnx
pi-controller/models/*.pt
pi-controller/models/*.onnx
pi-controller/models/*.onnx.data

# Third-party reference repos (cloned locally, not vendored)
3rdparty/

# Smoke test runtime artifacts (regenerated by tools/detection_smoke_test.py)
pi-controller/alerts_smoke.db
pi-controller/snapshots_smoke/
pi-controller/test_images/

# Simulator videos (large, regenerated by sim runs)
pi-controller/tools/sim_videos/
pi-controller/tools/carla_results/
