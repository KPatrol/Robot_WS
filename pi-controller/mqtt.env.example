# MQTT Configuration for K-Patrol Robot — TEMPLATE
# Copy this file to mqtt.env and fill in production credentials.
# mqtt.env is gitignored; never commit real credentials.

# MQTT Broker (VPS)
MQTT_HOST=your.broker.host.example
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_USERNAME=replace-with-username
MQTT_PASSWORD=replace-with-strong-password

# Robot Identity
ROBOT_SERIAL=KPATROL-001

# Topic namespace
MQTT_TOPIC_PREFIX=kpatrol

# Serial fallback (overridden by udev rules in production)
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUDRATE=115200
