# K-Patrol Robot Controller Configuration
# Copy này vào file .env hoặc chỉnh sửa trực tiếp trong scripts

# Serial Port Configuration
KPATROL_MOTOR_PORT=/dev/ttyKPATROL_MOTOR
KPATROL_ENCODER_PORT=/dev/ttyKPATROL_ENCODER
KPATROL_GPS_PORT=/dev/ttyKPATROL_GPS
KPATROL_BAUD_RATE=115200
KPATROL_GPS_BAUDRATE=9600

# Outdoor Mode (NEO-6M GPS)
# Set to 0 to disable GPS thread (indoor-only deployment)
KPATROL_GPS_ENABLED=1

# GPS wiring mode:
#   shared    — NEO-6M wired to ESP32-S3 UART2 (GPIO 41/42); firmware forwards
#               NMEA over the motor USB serial (default for V5.2 builds)
#   dedicated — NEO-6M on its own USB-TTL adapter at KPATROL_GPS_PORT
KPATROL_GPS_MODE=shared

# Speed Settings
KPATROL_DEFAULT_SPEED=150
KPATROL_MIN_SPEED=50
KPATROL_MAX_SPEED=255

# Timing
KPATROL_COMMAND_DELAY=0.05
KPATROL_TIMEOUT=1.0
