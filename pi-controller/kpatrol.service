[Unit]
Description=K-Patrol MQTT Robot Controller V5.x - Centralized Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=khoavd
Group=dialout
WorkingDirectory=/home/khoavd/kpatrol/pi-controller
EnvironmentFile=-/home/khoavd/kpatrol/pi-controller/config.env
EnvironmentFile=-/home/khoavd/kpatrol/pi-controller/mqtt.env
Environment=PYTHONUNBUFFERED=1
Environment=KPATROL_VPID_ENABLED=0
Environment=KPATROL_VPID_MAX_MPS=1.0
Environment=KPATROL_VPID_MAX_WZ=3.0
ExecStart=/usr/bin/python3 -u /home/khoavd/kpatrol/pi-controller/kpatrol_mqtt_v5.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
