# K-Patrol stable serial port symlinks
# ============================================================================
# Install:
#   sudo cp 99-kpatrol-serial.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Verify after plugging devices:
#   ls -la /dev/ttyKPATROL_*
#
# Identify your devices first (run BEFORE installing the rules):
#   for d in /dev/ttyUSB* /dev/ttyACM*; do
#     udevadm info -a -n "$d" | grep -E 'idVendor|idProduct|serial' | head
#   done
#
# Edit the ATTRS{idVendor}/ATTRS{idProduct}/ATTRS{serial} fields below to
# match your hardware. The values shipped here are typical for our build:
#   • ESP32-S3 motor controller — Espressif USB-JTAG (303a:1001)
#   • ESP32 Dev encoder/ToF    — CP2102 (10c4:ea60), unique serial #
#   • NEO-6M GPS via CH340     — 1a86:7523, distinguish by KERNELS path
# ============================================================================

# Motor controller — ESP32-S3.
# K-Patrol's S3 dev board uses a WCH CH9102 USB-Serial bridge (1a86:55d3)
# rather than the chip's built-in native USB (303a:1001). Both IDs are listed
# so swapping in a board with native USB still resolves to the same symlink.
# Without this rule the S3 enumerates as /dev/ttyACM0 (cdc_acm bind), which
# is unstable after brown-outs — udev-managed symlinks survive re-enumeration.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
    SYMLINK+="ttyKPATROL_MOTOR", MODE="0666", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", \
    SYMLINK+="ttyKPATROL_MOTOR", MODE="0666", GROUP="dialout"

# Encoder Dev + D1 R32 peripheral hub — both ship as CH340G (1a86:7523)
# and the chip has no programmable serial number, so we disambiguate by
# USB-hub slot. Cabling is fixed: encoder Dev → 1-1.3, periph hub → 1-1.2.
# Python also runs content discovery (see _classify_serial_port in
# kpatrol_mqtt_v5.py) so the bridge still recovers if a cable gets swapped
# in the field — but the udev symlinks below are the canonical stable path.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
    KERNELS=="1-1.3", \
    SYMLINK+="ttyKPATROL_ENCODER", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
    KERNELS=="1-1.2", \
    SYMLINK+="kpatrol-periph", MODE="0666", GROUP="dialout"

# Catch-all permission grant for any other CH340 (e.g. user plugs into a
# different slot for testing). No symlink — Python discovery handles it.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
    KERNELS!="1-1.2", KERNELS!="1-1.3", \
    MODE="0666", GROUP="dialout"
